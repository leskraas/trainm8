// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String  @unique
  name     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image                UserImage?
  password             Password?
  roles                Role[]
  sessions             Session[]
  connections          Connection[]
  passkey              Passkey[]
  workouts             Workout[]
  trainingSessions     WorkoutSession[]
  athleteProfile       AthleteProfile?
  exercises            Exercise[]
  activityImports      ActivityImport[]
  events               Event[]
  loadSnapshots        LoadSnapshot[]
  accountConnections   AccountConnection[]
  weekReplans          WeekReplan[]
  loadRecomputeNotices LoadRecomputeNotice[]
  catalogueSaves       CatalogueSave[]
  workoutReports       WorkoutReport[]       @relation("WorkoutReportReporter")
  moderatedReports     WorkoutReport[]       @relation("WorkoutReportModerator")
}

model UserImage {
  id        String  @id @default(cuid())
  altText   String?
  objectKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Password {
  hash String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Session {
  id             String   @id @default(cuid())
  expirationDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  // non-unique foreign key
  @@index([userId])
}

model Permission {
  id          String @id @default(cuid())
  action      String // e.g. create, read, update, delete
  entity      String // e.g. user, workout, etc.
  access      String // e.g. own or any
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles Role[]

  @@unique([action, entity, access])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions Permission[]
}

model Verification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// The type of verification, e.g. "email" or "phone"
  type String

  /// The thing we're trying to verify, e.g. a user's email or phone number
  target String

  /// The secret key used to generate the otp
  secret String

  /// The algorithm used to generate the otp
  algorithm String

  /// The number of digits in the otp
  digits Int

  /// The number of seconds the otp is valid for
  period Int

  /// The valid characters for the otp
  charSet String

  /// When it's safe to delete this verification
  expiresAt DateTime?

  @@unique([target, type])
}

model Connection {
  id           String @id @default(cuid())
  providerName String
  providerId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@unique([providerName, providerId])
}

model Passkey {
  id             String   @id
  aaguid         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  publicKey      Bytes
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  webauthnUserId String
  counter        BigInt
  deviceType     String // 'singleDevice' or 'multiDevice'
  backedUp       Boolean
  transports     String? // Stored as comma-separated values

  @@index(userId)
}

model Workout {
  id          String  @id @default(cuid())
  title       String
  description String?
  discipline  String // "run" | "swim" | "bike" | "strength"
  intent      String // see WORKOUT_INTENTS in workout-schema.ts

  // ── The Catalogue's four axes (ADR 0051) ─────────────────────────────────
  // Authorship, membership, collection and visibility are four orthogonal
  // questions about one Workout. Two of them live here; membership is a
  // `CatalogueEntry` row and collection is a `CatalogueSave` row.

  /// Authorship: who wrote it — 'system' (trainm8 shipped it) | 'athlete'.
  /// **Asserted, never inferred from `ownerId IS NULL`.** The inference is the
  /// bug `Exercise` already ships: `createdByAthleteId` goes null when an
  /// author's account is deleted and `getExerciseCatalog` then serves the row
  /// to everyone as a trainm8-authored entry. The migration's CHECK is the
  /// *implication* — `authorship = 'system'` ⟹ `ownerId IS NULL` — and not the
  /// biconditional, so an orphaned athlete-authored row stays expressible and
  /// reads "author gone" rather than "trainm8 says so".
  authorship String @default("athlete")

  // Visibility axis (ADR 0037), orthogonal to the session's Session Source and
  // — per ADR 0051 — one of four axes rather than two. A string with a
  // documented vocabulary and a private-by-default, matching the
  // `source`/`status` idiom — never a boolean.
  //
  // **`public` is live since #452** (ADR 0052), and it arrived with everything
  // that consumes it: the publish flow that writes it, the **Attribution** it
  // owes, the non-owner-scoped read path that serves it, and report-and-takedown.
  // The vocabulary is pinned by a CHECK in the migration — it was an unconstrained
  // string while it had one value, and a second value is where a typo becomes a
  // row nothing can read.
  visibility String @default("private") // "private" | "public" (ADR 0037, 0051, 0052)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Nullable since ADR 0051: a **Stock Workout** has no athlete author at all.
  /// `SetNull` rather than `Cascade` because deleting an athlete must not delete
  /// content the corpus offers to everyone; asserted `authorship` is what makes
  /// `SetNull` safe to read.
  owner    User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ownerId  String?
  blocks   WorkoutBlock[]
  sessions WorkoutSession[]
  // Week Pattern slots that stamp this Workout (ADR 0044). Stamping copies the
  // Workout per session, so a slot referencing it is an authoring reference and
  // never a live link into the stamped weeks.
  patternDays WeekPatternDay[]

  /// **The fork-on-write back-pointer** (ADR 0051 §5). One field, three jobs:
  /// the row a Catalogue fork was deep-copied from, the row an adopted
  /// generated session's prescription was copied from (#460), and — reached
  /// through `copiedFrom.catalogueEntry` — the citation the copy still carries.
  /// The citation is never copied onto the fork, so it cannot drift and
  /// `CatalogueEntry.retiredAt` keeps working through it.
  ///
  /// `SetNull`, never `Cascade`: deleting a source must orphan the lineage and
  /// never delete the athlete's own copy. Lineage is a chain, so a reader that
  /// wants the origin walks it rather than assuming one hop.
  copiedFrom   Workout?  @relation("WorkoutLineage", fields: [copiedFromId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  copiedFromId String?
  copies       Workout[] @relation("WorkoutLineage")

  /// Membership: is this Workout offered for reuse at all. 1:1 — a Workout is
  /// in the Catalogue or it is not.
  catalogueEntry CatalogueEntry?
  /// **Attribution** — the publish record of a **Shared Workout** (ADR 0052).
  /// 1:1, and structurally impossible on a **Stock Workout**: the mirror of the
  /// Citation rule, built the same way. Present iff this Workout has ever been
  /// published; `visibility` says whether it is published *now*.
  attribution Attribution?
  /// Reports raised against this Workout by other athletes (ADR 0052). The
  /// moderation gate the publish flow may not ship without.
  reports     WorkoutReport[]
  /// Collection: whose lists it is in. Many-per-Workout, and the count is a
  /// **ranking input, never a displayed number** (`GOAL.md`'s permanent no on
  /// the vanity layer — a "847 saves 🔥" badge is that layer through the back
  /// door).
  catalogueSaves CatalogueSave[]

  /// The parent key `CatalogueEntry` points at, so a Citation can only ever
  /// hang off a system-authored Workout (see `CatalogueEntry.workoutAuthorship`).
  /// `id` is already the primary key, so this is a real second index bought for
  /// that one consumer — the price of making the rule structural.
  @@unique([id, authorship])
  @@index([ownerId])
  @@index([copiedFromId])
}

/// **Membership** — the Catalogue's second axis, 1:1 with a Workout (ADR 0051).
/// A row rather than a boolean on `Workout`, because membership carries the
/// retrieval metadata the corpus is filtered by: `archetype × phase ×
/// goalEvent × level` (`workouts-running.md` §13.1). ADR 0044's rows-not-JSON
/// idiom decides the multi-valued facets.
model CatalogueEntry {
  id String @id @default(cuid())

  workout   Workout @relation(fields: [workoutId, workoutAuthorship], references: [id, authorship], onDelete: Cascade, onUpdate: Cascade)
  workoutId String  @unique
  /// The authorship of the Workout this entry belongs to, carried here so the
  /// Citation columns below can be constrained against it. A CHECK cannot reach
  /// another table, and this repo declines triggers (they would be invisible in
  /// this file and lost to a later table rebuild), so the parent's discriminator
  /// travels into the child and the composite foreign key requires it — the same
  /// construction `QualitySessionMixEntry.segmentKind` already uses.
  workoutAuthorship String @default("athlete")

  /// **Session Archetype** — the corpus's primary retrieval filter. Sixteen
  /// values (see `SESSION_ARCHETYPES` in `catalogue.ts`). Authored here and
  /// derived on a session: a Catalogue Entry is a corpus row published *as* a
  /// threshold session, where a session in a week is classified against that
  /// week (ADR 0042's derived-never-authored rule, which this does not breach —
  /// see ADR 0051 §3).
  archetype String
  /// The **level floor**: the lowest athlete level this row is appropriate for
  /// (`workouts-running.md` §12 rates rows off-limits below a band). Null is a
  /// positive statement — the row is not level-scoped — and never "unknown".
  level     String?

  /// **Citation** — the published source a **Stock Workout** comes from, in
  /// four columns rather than one string so a reader can render the parts.
  /// Non-null **only** when the Workout is system-authored, enforced by a CHECK
  /// against `workoutAuthorship` above. A nullable citation an athlete may fill
  /// is the worst outcome: it puts "Daniels 2013" on a session Daniels never
  /// wrote, in the same slot as real authority. A community row carries an
  /// **Attribution** instead, which is #452's to build with its publish flow.
  citationAuthor  String?
  citationWork    String?
  citationYear    Int?
  /// DOI, ISBN or URL — whatever the source is actually locatable by.
  citationLocator String?

  /// Progression edges (`workouts-running.md` §12), as edges rather than prose.
  /// `SetNull`: retiring one row must not delete the rows that pointed at it.
  progressesTo   CatalogueEntry?  @relation("CatalogueProgression", fields: [progressesToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  progressesToId String?
  progressedFrom CatalogueEntry[] @relation("CatalogueProgression")
  regressesTo    CatalogueEntry?  @relation("CatalogueRegression", fields: [regressesToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  regressesToId  String?
  regressedFrom  CatalogueEntry[] @relation("CatalogueRegression")

  /// Retirement, never deletion: a stock session later found mis-cited must stop
  /// being **retrievable** without vanishing from the plans that already used it
  /// — and a back-pointer through `Workout.copiedFromId` still resolves to it.
  retiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases     CatalogueEntryPhase[]
  goalEvents CatalogueEntryGoalEvent[]

  /// 1:1 with its Workout. `workoutId` alone is already unique; Prisma needs the
  /// full relation key unique too, to know the composite relation is one-to-one.
  @@unique([workoutId, workoutAuthorship])
  @@index([archetype])
  @@index([progressesToId])
  @@index([regressesToId])
}

/// A phase this Catalogue Entry is appropriate in. Multi-valued — most rows span
/// two or three (`workouts-running.md` §12) — so rows, not a JSON array. No rows
/// means the entry is not phase-scoped, which is a positive statement.
model CatalogueEntryPhase {
  id String @id @default(cuid())

  entry   CatalogueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entryId String
  /// 'base' | 'build' | 'peak' | 'taper' | 'race-week' — see `CATALOGUE_PHASES`.
  phase   String

  @@unique([entryId, phase])
}

/// A goal event this Catalogue Entry serves. The **Discipline** comes from the
/// Workout, so this names the distance only — a swimmer's 1500 m and a runner's
/// are the same row shape read through different parents.
model CatalogueEntryGoalEvent {
  id String @id @default(cuid())

  entry     CatalogueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entryId   String
  /// A `RACE_ANCHORS` value, or 'trail' / 'ultra' — see `CATALOGUE_GOAL_EVENTS`.
  goalEvent String

  @@unique([entryId, goalEvent])
}

/// **Collection** — the Catalogue's third axis (ADR 0051). "It is in my list",
/// which for a retrieval corpus is overwhelmingly sessions the athlete did *not*
/// write. Many-per-Workout, and it points at the **original**: saving copies
/// nothing, so attribution survives unforked and adoption stays countable.
model CatalogueSave {
  id String @id @default(cuid())

  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workoutId String
  owner     User    @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerId   String

  createdAt DateTime @default(now())

  /// One athlete saves one Workout once.
  @@unique([workoutId, ownerId])
  @@index([ownerId])
}

/// **Attribution** — what a **Shared Workout** displays instead of a **Citation**
/// (ADR 0052, deferred here by ADR 0051 §7 until it had a writer).
///
/// A different slot from the Citation, deliberately: the whole point of the
/// asymmetry is that community content can never look cited. So the two are
/// mirror constructions — `CatalogueEntry` carries the parent's discriminator and
/// forbids citation columns unless it reads `'system'`; this table carries the
/// same discriminator and cannot exist at all unless it reads `'athlete'`.
/// `ON UPDATE CASCADE` closes both back doors.
///
/// The non-vouch is **not stored**. It is trainm8's standing statement about
/// itself rather than a fact about the row, so it lives in code
/// (`COMMUNITY_NON_VOUCH`) where it cannot be per-row edited, absent, or
/// disagreed with.
model Attribution {
  id String @id @default(cuid())

  workout           Workout @relation(fields: [workoutId, workoutAuthorship], references: [id, authorship], onDelete: Cascade, onUpdate: Cascade)
  workoutId         String  @unique
  /// Always `'athlete'` — the composite foreign key pins it to the parent and a
  /// CHECK forbids `'system'`. A **Stock Workout** carries a Citation instead.
  workoutAuthorship String  @default("athlete")

  /// The publishing athlete's **public identity**, snapshotted at publish time
  /// and confirmed by them on the publish screen. Snapshotted rather than joined
  /// because `Workout.ownerId` is `SetNull`: an author who deletes their account
  /// leaves an orphan, and a join would render it as nobody. What an athlete
  /// publishes under is also their choice, which a join cannot express.
  displayName String

  /// When it was last published. A row that has been unpublished keeps this — the
  /// Attribution is the publish *record*, and `Workout.visibility` is the live
  /// state.
  publishedAt DateTime @default(now())

  /// The **moderator's** takedown, whole or absent (a reason with no date, or a
  /// date with no reason, is pinned out by a CHECK). Set means the row is
  /// permanently unpublishable: a takedown a republish could undo is not a
  /// takedown. The author's own unpublish leaves these null — that is a different
  /// act and it is reversible.
  takenDownAt    DateTime?
  takedownReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Prisma needs the full relation key unique for the composite 1:1.
  @@unique([workoutId, workoutAuthorship])
}

/// **The moderation gate** (ADR 0052). A report one athlete raises against a
/// **Shared Workout** — the half of #452 the publish flow may not merge without.
///
/// `reporterId` is `SetNull` rather than `Cascade` because the report is a record
/// about the *content*: a moderator's queue that empties itself when a reporter
/// deletes their account is a takedown path an author can wait out.
model WorkoutReport {
  id String @id @default(cuid())

  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workoutId String

  reporter   User?   @relation("WorkoutReportReporter", fields: [reporterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reporterId String?

  /// A closed vocabulary — see `REPORT_REASONS` in `community.ts`. Free text is
  /// the `detail`, and the reason is what the queue is triaged by.
  reason String
  detail String?

  createdAt DateTime @default(now())

  /// Whole or absent: a resolved report says *how* it was resolved
  /// (`taken-down` | `dismissed`) and who resolved it.
  resolvedAt   DateTime?
  resolution   String?
  resolvedBy   User?     @relation("WorkoutReportModerator", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resolvedById String?

  /// One athlete reports one Workout once — a second report is the same athlete
  /// saying the same thing louder, which is the brigading vector this closes.
  @@unique([workoutId, reporterId])
  @@index([workoutId])
  @@index([reporterId])
  @@index([resolvedAt])
}

model WorkoutBlock {
  id         String  @id @default(cuid())
  name       String?
  orderIndex Int

  // Two repeat levels (ADR 0007). `repeatCount` is the inner one — the reps
  // inside one series — and `seriesRepeatCount` the outer one, so
  // `3 × (13 × 30/15)` is `seriesRepeatCount 3` over `repeatCount 13`. The
  // effective number of passes is the product; read it through
  // `blockRepeatTotal()` (workout-schema.ts) rather than multiplying by hand.
  repeatCount       Int  @default(1)
  seriesRepeatCount Int  @default(1)
  // The recovery between series. Only meaningful when seriesRepeatCount > 1;
  // the rest *inside* a series is an ordinary rest step.
  betweenSeriesRestSec Int?

  // JSON: SendOff discriminated union (see workout-schema.ts). The cycle time a
  // repeat group leaves on, where the rest is the residual after the work —
  // swimming's universal form. A block carries either a send-off or rest steps,
  // never both.
  sendOff String?

  workout   Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workoutId String
  steps     WorkoutStep[]

  @@index([workoutId])
}

model WorkoutStep {
  id         String  @id @default(cuid())
  kind       String  @default("cardio") // "cardio" | "strength" | "rest"
  notes      String? // free-text notes (was description)
  orderIndex Int

  // cardio-only fields
  discipline  String? // "run" | "swim" | "bike"
  intensity   String? // JSON: IntensityTarget discriminated union (see workout-schema.ts)
  durationSec Int?
  distanceM   Int?
  // The third Step Quantity (ADR 0002), mutually exclusive with the other two:
  // vertical repeats, mountain long runs and VK tests quantify in metres of
  // climb and in neither time nor ground distance.
  verticalM   Int?

  // Step parameters — not quantities, so they coexist with one. Grade may be
  // negative (a descent). Cadence is a prescription in its own right: six
  // cycling sessions have it as their defining variable.
  gradePct      Float?
  cadenceRpmMin Int?
  cadenceRpmMax Int?

  // rest-only field. JSON: RestSpec discriminated union (see workout-schema.ts)
  // — rest takes four forms in the field and `durationSec` is only the first.
  // When the spec is `time`, `durationSec` carries the same number so every
  // existing duration reader keeps working; under any other form `durationSec`
  // stays null, because that rest's length is not a number we have.
  rest String?

  // strength-only fields
  exerciseId         String?
  restBetweenSetsSec Int?

  // resolved intensity ranges (filled by background job)
  intensityHrMin    Int?
  intensityHrMax    Int?
  intensityPowerMin Int?
  intensityPowerMax Int?
  intensityPaceMin  Int?
  intensityPaceMax  Int?

  block    WorkoutBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  blockId  String
  exercise Exercise?     @relation(fields: [exerciseId], references: [id])
  sets     ExerciseSet[]

  @@index([blockId])
  @@index([exerciseId])
}

model Exercise {
  id                 String  @id @default(cuid())
  name               String
  primaryMuscle      String // MuscleGroup: chest | back | shoulders | biceps | triceps | forearms | abs | obliques | lower-back | glutes | quads | hamstrings | calves | hip-flexors | full-body
  equipment          String? // e.g. "barbell" | "dumbbell" | "bodyweight" | "machine" | "cable"
  isCompound         Boolean @default(false)
  createdByAthleteId String? // null for seed/catalog entries

  createdBy User?         @relation(fields: [createdByAthleteId], references: [id], onDelete: SetNull)
  steps     WorkoutStep[]

  @@index([createdByAthleteId])
}

model ExerciseSet {
  id         String @id @default(cuid())
  orderIndex Int
  // The set-termination rule (ADR 0007): "reps" | "timed" | "amrap" | "toRir" |
  // "velocityLoss". A velocity-loss or to-RIR set has no authored rep count —
  // it ends when a condition is met.
  kind       String

  // Load — the authored form, a LoadTarget discriminated union in JSON (see
  // workout-schema.ts): absolute kg, % 1RM, a rep-max reference (`10RM`),
  // bodyweight ± added load, % bodyweight, or a bar velocity.
  load String?

  // The legacy load projection, kept beside `load` for one release the way ADR
  // 0047's retired columns were. A set authored as `{kind:'absolute'}` or
  // `{kind:'pct1RM'}` mirrors here; the other four load kinds have nothing to
  // mirror into and leave both null.
  weightKg Float?
  pct1RM   Float?

  // Effort cap — JSON: EffortCap discriminated union. Orthogonal to load and
  // routinely co-occurring with it: "4 reps at 85 % 1RM, stopping at RIR 2" has
  // a value on both axes.
  effortCap String?

  // Eccentric-pause-concentric, e.g. "3-0-3"; "X" for maximal intent. Load-
  // bearing for the heavy-slow-resistance family and inert elsewhere.
  tempo String?

  // kind-specific quantities
  reps            Int?
  durationSec     Int?
  terminationRir  Float? // kind = "toRir": stop when reps in reserve reach this
  velocityLossPct Float? // kind = "velocityLoss": stop at −N % mean velocity

  step   WorkoutStep @relation(fields: [stepId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stepId String

  @@index([stepId])
}

model WorkoutSession {
  id            String   @id @default(cuid())
  scheduledAt   DateTime // stored UTC
  status        String   @default("scheduled") // "scheduled" | "completed" | "skipped" | "missed"
  tssValue      Float? // computed TSS for this session (null = unavailable)
  tssFormula    String? // 'coggan' | 'hrTSS' | 'rTSS' | 'sTSS' | 'sRPE'
  tssConfidence String? // 'high' | 'medium' | 'low'

  // Planned TSS (ADR 0019): the stress the prescription implies, computed from
  // each Step's resolved intensity midpoint via the same Load Formula as actual
  // TSS. Compared to `tssValue` as the Adherence Band; never feeds CTL/ATL/TSB.
  plannedTssValue      Float? // null = unavailable (no step resolved)
  plannedTssConfidence String? // 'full' | 'partial' (null when value is null)

  // Replan Note (ADR 0025): the plain-language reason attached when a Week
  // Replan softened this session's volume. Null = never softened.
  replanReason String?

  /// **Session Source** — where this session came from, and *only* that
  /// (ADR 0016, 0033; split by #460). `authored` (the athlete wrote it),
  /// `generated` (Plan Generation), `recorded` (a recording-only session with no
  /// structure) or `detected` (a recording-only session whose Workout was
  /// auto-materialized from a Structure Detection, ADR 0033).
  ///
  /// **Immutable with respect to the athlete.** It used to carry a second job —
  /// "has the athlete taken this over" — and an edit overwrote the origin to
  /// record the takeover, which is why rescheduling a `detected` session
  /// permanently destroyed re-detection (#459). The takeover lives in
  /// `adoptedAt` now, so nothing an athlete does rewrites this column.
  ///
  /// The one write that remains is the engine's own `recorded` ⇄ `detected`
  /// pair, as a detection materializes onto a recording-only session or is
  /// retracted from it. That is the *same* engine restating what it found about
  /// its own recording, never a takeover, and it is guarded to unadopted
  /// sessions.
  source    String    @default("authored") // "authored" | "generated" | "recorded" | "detected"
  /// **Session Adoption** (#460) — when the athlete took a machine-produced
  /// session over. Null means untouched, which is what re-detection (ADR 0033)
  /// and regeneration (ADR 0016) are really asking about; a timestamp means the
  /// prescription is the athlete's now, and its machine-written predecessor is
  /// preserved as `workout.copiedFrom` rather than deleted.
  ///
  /// Set only when a save actually changes the prescription — the blocks, the
  /// discipline or the intent. A reschedule, a rename, or a no-op save is not a
  /// takeover (#459).
  adoptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId        String
  workout       Workout?        @relation(fields: [workoutId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workoutId     String? // nullable — recording-only sessions have no Workout
  recording     ActivityImport? @relation("SessionRecording", fields: [recordingId], references: [id])
  recordingId   String? // nullable FK to ActivityImport
  sessionLog    SessionLog?
  eventResults  Event[]         @relation("EventResult")
  // Target Event anchor (PRD #103): the Event a generated session periodizes
  // toward. Distinct from `Event.resultSessionId` (the Event Result).
  targetEvent   Event?          @relation("TargetEvent", fields: [targetEventId], references: [id], onDelete: SetNull)
  targetEventId String?

  promotedImports ActivityImport[] @relation("ImportPromotedTo")

  @@index([userId])
  @@index([userId, scheduledAt])
  @@index([targetEventId])
}

model AthleteProfile {
  id             String    @id @default(cuid())
  birthdate      DateTime?
  weightKg       Float?
  heightCm       Float?
  sex            String? // "male" | "female" | "prefer_not_to_say"
  preferredUnits String    @default("metric") // "metric" | "imperial"
  weekStartsOn   Int       @default(1) // 0=Sun … 6=Sat; 1=Mon per ADR 0005
  timezone       String    @default("UTC") // IANA timezone string

  // Training Availability (PRD #103): days the athlete can train and a
  // default time-of-day, reused across plan generations. Times are interpreted in
  // `timezone`. Null = never set (empty state), distinct from an explicit empty list.
  trainableWeekdays   String? // JSON array of weekday numbers 0=Sun…6=Sat, e.g. "[1,3,6]"
  defaultTrainingTime String? // "HH:MM" 24h local time interpreted in `timezone`
  // Weekly Capacity (ADR 0050): hours per Training Week the athlete has room for.
  // Pre-filled from their own recent weekly hours with the derivation shown, then
  // **authored** — nothing re-reads history afterwards (ADR 0040 §6). Per week and
  // never per day, since availability is not uniform across the days. Null = never
  // set, and an unset capacity makes the hours fit check unavailable, never passing.
  weeklyCapacityHours Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  disciplineProfiles DisciplineProfile[]
  thresholdEvents    ThresholdEvent[]
  performanceResults PerformanceResult[]
}

/// One dated maximal performance — the queryable history a **Race Equivalence**
/// resolves from, and the single blocker the research named for portable
/// race-pace targets (`docs/research/portable-intensity-anchors.md` §7.2; ADR
/// 0007, #449).
///
/// Distinct from an **Event Target**, which is a *goal*: a goal that was met
/// produces a result and a goal that was missed produces one too, so the two
/// must not be overloaded onto one field. Distinct from a **Personal Record**,
/// which is the *derived best* over a **Benchmark Kind** — a Performance Result
/// is the raw datum a record is chosen from.
///
/// `source` separates a race from a repeated time trial from a training
/// segment, because the tradition's most reliable non-race anchor is a
/// deliberately repeated effort rather than a curve fit. `verified` records
/// whether the effort came with telemetry the app itself read, so a hand-typed
/// figure never masquerades as a measured one.
model PerformanceResult {
  id         String   @id @default(cuid())
  discipline String // "run" | "bike" | "swim"
  distanceM  Int
  timeSec    Int
  occurredAt DateTime
  source     String // "race" | "timeTrial" | "trainingSegment"
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  athleteProfileId String

  @@index([athleteProfileId])
  @@index([athleteProfileId, discipline, distanceM, occurredAt])
}

model DisciplineProfile {
  id                    String  @id @default(cuid())
  discipline            String // "run" | "bike" | "swim" | "strength"
  maxHr                 Int?
  lthr                  Int?
  ftp                   Int? // bike only, nullable for others
  runPowerThresholdW    Int? // run only: critical running power in W (ADR 0038)
  thresholdPaceSecPerKm Int? // run only
  cssSecPer100m         Int? // swim only
  zoneSystem            String? // recipe id string
  // How `zoneSystem` got there (#454): "default" = the app's per-discipline
  // default, "athlete" = they picked it on /settings/training. Stored rather than
  // inferred by comparing the id against the default, because an athlete who
  // deliberately picks the recipe that is also the default has still chosen it,
  // and the surface must not tell them the app did. Null where there is no recipe
  // to source (strength) — or, transiently, on a row that predates the backfill.
  zoneSystemSource      String?
  zoneOverrides         String? // JSON blob
  enabled               Boolean @default(true)
  preferCogganTss       Boolean @default(false) // bike: use Coggan TSS when FTP set (opt-in per ADR 0008)
  preferRTSS            Boolean @default(false) // run: use rTSS when threshold pace set (opt-in per ADR 0008)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  athleteProfileId String

  @@unique([athleteProfileId, discipline])
  @@index([athleteProfileId])
}

model ThresholdEvent {
  id           String   @id @default(cuid())
  discipline   String // "run" | "bike" | "swim" | "strength"
  kind         String // "maxHr" | "lthr" | "ftp" | "runPower" | "thresholdPace" | "css" | "weight"
  valueNumeric Float
  source       String   @default("manual") // "manual" | "inferred" | "auto"
  effectiveAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  athleteProfileId String

  @@index([athleteProfileId])
  @@index([athleteProfileId, discipline])
}

model Event {
  id          String    @id @default(cuid())
  name        String
  kind        String // 'race' | 'time-trial' | 'fitness-goal'
  priority    String // 'A' | 'B' | 'C'
  startDate   DateTime
  endDate     DateTime?
  disciplines String // JSON-encoded Discipline[]
  target      String? // JSON-encoded EventTarget
  location    String?
  status      String    @default("planned") // 'planned' | 'completed' | 'cancelled'
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete           User             @relation(fields: [athleteId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  athleteId         String
  resultSession     WorkoutSession?  @relation("EventResult", fields: [resultSessionId], references: [id], onDelete: SetNull)
  resultSessionId   String?
  // Generated sessions anchored to this Event as their Target Event (PRD #103).
  generatedSessions WorkoutSession[] @relation("TargetEvent")
  // The Plan Outline this Event anchors (ADR 0044). Was a JSON-encoded blob on
  // this row until the Outline became athlete-authored primary data; null when
  // no plan anchors here, which makes the Event a calendar marker (ADR 0018).
  planOutline       PlanOutline?

  @@index([athleteId])
  @@index([athleteId, startDate])
}

/// The periodized structure spanning a plan's horizon — a sequence of phases
/// plus the Training Tracks measured over them (CONTEXT.md "Plan Outline").
/// Stored relationally rather than as a JSON blob on the Event, because manual
/// authoring makes it primary data the athlete edits piece by piece rather than
/// generation output written once (ADR 0044 §1). One per Event.
model PlanOutline {
  id String @id @default(cuid())

  /// The plan's first Training Week: that week's Monday, YYYY-MM-DD in the
  /// Athlete Timezone — the `WeekReplan.weekKey` idiom (ADR 0025). Authored
  /// rather than derived backward from the Event date, so adding a phase never
  /// moves weeks the athlete has already lived (ADR 0044 §3). The plan's end is
  /// derived, and may fall short of or past the Event; that is shown, not fixed.
  startWeekKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventId  String             @unique
  phases   PlanOutlinePhase[]
  tracks   TrainingTrack[]
  patterns WeekPattern[]
}

/// One stretch of the season: its span, its intent, its loading/recovery rhythm
/// and whether it tapers. A phase carries no volume, no unit, no discipline and
/// no intensity emphasis — it says *when* and *why*, never *how much* or *how
/// hard* (ADR 0041, 0042).
model PlanOutlinePhase {
  /// 0-based position. Phases are contiguous by construction: a phase carries no
  /// dates of its own, and its span is derived from the Outline's `startWeekKey`
  /// plus the weeks of the phases before it. A gap or an overlap in the season is
  /// therefore unrepresentable rather than merely invalid (ADR 0044 §3).
  orderIndex Int
  /// Free text, and the only word a phase carries (ADR 0042 §1). Deliberately not
  /// an enum: nothing in the app branches on it, the name carries *intent* that no
  /// derived quantity can, and a closed vocabulary would refuse "Off-season" or
  /// "Return to run" (ADR 0044 §2). Preset names are #371's.
  name       String
  weeks      Int
  /// Which weeks of the phase are recovery weeks — time structure, so it belongs
  /// here. The *size* of the cut is a volume quantity and belongs to the track
  /// segment (ADR 0041 §1, ADR 0044 §4). A strength track ignores this entirely:
  /// its deload comes when MRV is reached, not when the phase says so.
  rhythm     String  @default("3:1") // '3:1' | '2:1' | 'none'
  /// Whether this phase tapers. The magnitude is the track segment's `taperCut`.
  tapers     Boolean @default(false)

  id        String @id @default(cuid())
  outline   PlanOutline @relation(fields: [outlineId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  outlineId String
  /// The endurance segments measured over this phase, one per Training Track.
  segments  TrainingTrackSegment[]

  /// The composite unique below also serves lookups by `outlineId` alone — its
  /// leading column — so no separate index on it.
  @@unique([outlineId, orderIndex])
}

/// One Discipline measured over a Plan Outline's phases, owning its Volume
/// Currency, its progression rule and its own segmentation (ADR 0041, 0043). No
/// track is the plan's spine: a pure runner and a pure lifter each author one, a
/// triathlete who lifts authors four — over one shared phase timeline.
model TrainingTrack {
  id         String @id @default(cuid())
  discipline String // Discipline: 'run' | 'bike' | 'swim' | 'strength'
  /// Volume Currency: the unit this track authors volume in. **Immutable for the
  /// life of the track** (ADR 0043 §2) — changing it would rewrite the unit of
  /// every week already lived. Enforced by the value vocabulary in the migration's
  /// CHECK plus the absence of `currency` from every update input, pinned by a
  /// test; changing currency is re-authoring, not an edit (ADR 0044 §8).
  /// 'sets' means total working sets per week — a *systemic* scalar, never per
  /// muscle group and never per movement (ADR 0047 §2).
  currency   String // 'km' | 'hours' | 'tss' | 'sets'

  outline     PlanOutline           @relation(fields: [outlineId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  outlineId   String
  anchors     SeasonAnchorSegment[]
  segments    TrainingTrackSegment[]
  overrides   WeekVolumeOverride[]
  patternDays WeekPatternDay[]

  /// One track per Discipline (ADR 0043 §1) — a structural constraint, not a
  /// service-layer rule.
  @@unique([outlineId, discipline])
}

/// The athlete's authored starting volume for a track's season, as dated segments
/// rather than one number, so lowering volume mid-season never rewrites weeks
/// already lived (ADR 0040 §5). A segment carries no unit — the unit is the
/// track's Volume Currency, so a re-anchor changes value only (ADR 0043).
model SeasonAnchorSegment {
  id String @id @default(cuid())
  /// The week this anchor takes effect: that week's Monday, YYYY-MM-DD. The
  /// Volume Ramp's loading-week index restarts here (ADR 0040 §5).
  fromWeekKey String
  value       Float

  track   TrainingTrack @relation(fields: [trackId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trackId String

  @@unique([trackId, fromWeekKey])
}

/// One stretch of a Training Track over which its progression is authored — never
/// a unit (ADR 0043). Both kinds progress by the *same* rule — the track's Season
/// Anchor times this segment's `ramp` and `boundaryStep` (ADR 0047 §1) — and are
/// stored as a discriminated union with nullable per-kind fields, the
/// `WorkoutStep.kind` idiom, because what they *author* differs: an endurance
/// segment spans exactly one phase and carries a Quality Session Mix (ADR 0042
/// §8), while a strength segment is dated, floats free of the phases, and carries
/// a Strength Goal and a Strength Frequency instead (ADR 0047 §3/§4/§6).
model TrainingTrackSegment {
  id   String @id @default(cuid())
  kind String // 'endurance' | 'strength'

  // ── both kinds ───────────────────────────────────────────────────────────
  // The progression itself, shared since ADR 0047 §1 gave a strength segment the
  // same Season Anchor and the same rate an endurance one has.
  /// Volume Ramp: percent per *loading* week, unit-free, so a track authored in km
  /// never converts to hours (ADR 0040 §10).
  ramp         Float?
  /// Block Boundary Step: the volume change at this segment's opening. Null means
  /// 0 — continuity is the default, and an authored step is intent the ramp guard
  /// stays silent on (ADR 0040 §4). It applies at each strength segment's opening
  /// the way it applies at each endurance phase boundary.
  boundaryStep Float?

  // ── endurance-only ───────────────────────────────────────────────────────
  /// The phase this segment spans, 1:1 (ADR 0042 §8). Its dates are the phase's,
  /// so they cannot drift from it.
  phase        PlanOutlinePhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  phaseId      String?
  /// How deep a recovery week cuts. Null means "follow the documented convention"
  /// (−30%, intervals.icu's default) rather than a stored default, so moving the
  /// convention later leaves the athlete's own numbers untouched (ADR 0044 §4).
  /// A recovery week never reduces the Quality Session Mix: the taper and deload
  /// literature cuts volume and holds intensity *and* frequency.
  recoveryCut  Float?
  /// How deep the taper cuts by the event, where the phase tapers. Null means the
  /// documented convention (−50%; Bosquet 2007 measured 41–60%). The taper's
  /// *shape* is a progressive function in code, never per-week stored values.
  taperCut     Float?

  // ── strength-only ────────────────────────────────────────────────────────
  // Nullable columns, required per *kind*: the migration's
  // `TrainingTrackSegment_kind_position` CHECK requires `startWeekKey`, `weeks`,
  // `goal` and `sessionsPerWeek` on a strength row and forbids all four on an
  // endurance one. Requiredness is the CHECK's to state and not the column's,
  // because one pair of columns carries both kinds.
  /// Where this segment opens, YYYY-MM-DD Monday — a strength segment is dated
  /// because it floats free of the phases, and because a gap between segments is
  /// a meaningful state ("no lifting these weeks") rather than a defect.
  startWeekKey String?
  /// Authored duration; start-plus-length rather than start-plus-end because
  /// length is what an athlete edits. (ADR 0041 §4 justified this by segment length
  /// being a consequence of reaching MRV — retired with the landmarks, ADR 0047 §6.
  /// The field shape survives on plain representation grounds.)
  weeks           Int?
  /// Strength Goal: the adaptation this block is for — 'hypertrophy' |
  /// 'maximal-strength' | 'power', ACSM 2026's three under the field's own term for
  /// the middle one (ADR 0047 §3). The `%1RM` band and rep range are **derived**
  /// from it and never authored beside it, because a band cannot express the
  /// distinction — ACSM's strength prescription is ≥80% 1RM and hypertrophy occurs
  /// at 80%+ too, so what separates the goals is the volume. It derives the
  /// *intensity* side only, never sets per week: that stays the Season Anchor's and
  /// the ramp's, or the plan would have two sources for one number.
  /// **Required on a strength segment** by the per-kind CHECK: it is what the
  /// segment authors and has no convention to fall back to, so a null here is an
  /// unauthored block rather than a deferred choice.
  goal            String?
  /// Strength Frequency: sessions per week, the authored counterpart to the
  /// endurance track's derived Quality Session Count (ADR 0047 §4). The one strength
  /// parameter with primary-source frequency evidence (Pelland 2026; ACSM ≥2/wk).
  /// Supplies the strength Summary Count's denominator for an unmaterialized week
  /// (ADR 0046 §4) and the days-against-days fit check against `trainableWeekdays`.
  /// It does **not** make calendar cost in hours derivable — that needs a
  /// per-session duration too, so ADR 0046 §3's Unavailable Metric stands.
  /// **Required on a strength segment** by the per-kind CHECK, for `goal`'s reason:
  /// a block with no frequency has no second number for the days-against-days fit
  /// check to read, and a reader that skipped it would hide the block entirely.
  sessionsPerWeek Int?
  /// Deload depth and length. Null means convention (−50% over 1 week; Bell 2025
  /// specifies 40–60% and 5–7 days). A strength boundary drop is intent and is
  /// never flagged (ADR 0041 §4).
  deloadCut       Float?
  deloadWeeks     Int?

  track   TrainingTrack            @relation(fields: [trackId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trackId String
  mix     QualitySessionMixEntry[]

  /// An endurance track holds at most one segment per phase. NULLs are distinct in
  /// SQLite, so this does not constrain the strength segments.
  @@unique([trackId, phaseId])
  /// Two strength segments cannot open in the same week.
  @@unique([trackId, startWeekKey])
  /// The parent key a Quality Session Mix entry points at, so the mix can only hang
  /// off an *endurance* segment (see `QualitySessionMixEntry.segmentKind`). `id` is
  /// already the primary key, so this is a real second index bought for that one
  /// consumer — the price of making the rule structural rather than a convention.
  @@unique([id, kind])
  /// `phaseId` needs its own index: it leads no unique above.
  @@index([phaseId])
}

/// The intensive sessions per week an endurance segment authors: a multiset of
/// Training Zone → count, the second authored axis beside volume (ADR 0042 §3).
/// Zones 3–5 only, enforced by a CHECK in the migration. No rows means an empty
/// mix, which is a positive statement that the segment has no quality sessions —
/// so it is deliberately *not* used to mean "unknown".
model QualitySessionMixEntry {
  id              String @id @default(cuid())
  zone            Int // TrainingZone, 3–5
  sessionsPerWeek Int

  segment     TrainingTrackSegment @relation(fields: [segmentId, segmentKind], references: [id, kind], onDelete: Cascade, onUpdate: Cascade)
  segmentId   String
  /// The kind of segment this mix may hang off, pinned to 'endurance' by a CHECK.
  /// A strength segment authors its intensity as a Strength Goal instead (ADR 0047
  /// §3), and this carries that rule into the foreign key: a mix entry can only
  /// resolve against an endurance parent. It is stored rather than checked because
  /// a CHECK cannot reach another table, and this repo declines triggers — they
  /// would be invisible here and lost to a later table rebuild.
  segmentKind String @default("endurance")

  /// A zone cannot appear twice in one mix.
  @@unique([segmentId, zone])
}

/// A week the athlete hand-set, overriding the derived target. Stored lazily —
/// absent unless authored (ADR 0040 §5).
model WeekVolumeOverride {
  id      String @id @default(cuid())
  weekKey String
  /// The week's **final** target in the track's Volume Currency: the week's role
  /// factor is *not* applied on top, or the number the athlete typed would never
  /// be the number they get. A leaf, never folded — the next week still computes
  /// from the anchor and the ramp, keeping ADR 0040 §3's indexed derivation
  /// (ADR 0044 §5). `0` expresses a week without training, needing no flag.
  value   Float

  track   TrainingTrack @relation(fields: [trackId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trackId String

  @@unique([trackId, weekKey])
}

/// A reusable microcycle the athlete stamps across the plan's weeks (#365). It
/// leaves standalone Workout Sessions behind with no live link back, so editing
/// one stamped week never touches its siblings — which requires stamping to copy
/// the `Workout` per session, as generation already did. Per-plan in V1; whether
/// a named pattern is also athlete-owned and reusable across plans belongs to the
/// future **Plan Template** effort (#375 closed out of scope), and the Outline's
/// shape is invariant under every answer it can give (ADR 0044 §6).
model WeekPattern {
  id         String @id @default(cuid())
  name       String
  orderIndex Int

  outline   PlanOutline      @relation(fields: [outlineId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  outlineId String
  days      WeekPatternDay[]

  @@unique([outlineId, orderIndex])
}

/// One slot in a Week Pattern. A pattern cannot hold absolute quantities, because
/// the week's volume target is derived and changes week to week (ADR 0040 §1), so
/// a day is either a *fixed* session stamped as authored — intervals are
/// prescribed, not scaled — or a *share* that absorbs its part of the week's
/// remaining volume by relative weight (ADR 0044 §7). Weights are normalised at
/// stamp time, so "the shares sum to 97%" is unrepresentable.
model WeekPatternDay {
  id         String @id @default(cuid())
  weekday    Int // 0 = Monday … 6 = Sunday (the Training Week is Mon–Sun, ADR 0019)
  orderInDay Int    @default(0)
  kind       String // 'fixed' | 'share'
  /// share-only: relative weight, normalised across the week's share days.
  weight     Float?
  /// fixed: the Workout stamped as authored. share: an optional shape to scale.
  workout    Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  workoutId  String?

  pattern   WeekPattern   @relation(fields: [patternId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  patternId String
  /// Which track's volume this day draws from — a foreign key rather than a loose
  /// discipline string, since the pattern lives on the same Outline as the track.
  track     TrainingTrack @relation(fields: [trackId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trackId   String

  @@unique([patternId, weekday, orderInDay])
  /// Both lead no unique above, so both need their own index.
  @@index([trackId])
  @@index([workoutId])
}

model SessionLog {
  id      String @id @default(cuid())
  content String // athlete's text reflection
  rpe     Int? // Rate of Perceived Exertion, 1–10

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sessionId String         @unique
}

model ActivityImport {
  id                String   @id @default(cuid())
  athleteId         String
  externalProvider  String // 'manual' | 'strava' | 'intervalsicu' | 'garmin'
  externalId        String
  startedAt         DateTime
  endedAt           DateTime
  durationSec       Int
  distanceM         Float?
  discipline        String // run | bike | swim | strength
  hrAvg             Float?
  hrMax             Float?
  powerAvg          Float?
  powerMax          Float?
  powerWeightedAvg  Float? // provider weighted-average power ≈ Normalized Power
  cadenceAvg        Float?
  paceAvgSecPerKm   Float?
  speedMaxMps       Float?
  elevationGainM    Float?
  kilojoules        Float? // total mechanical work (rides)
  polyline          String?
  phaseBarsJson     String? // derived intensity-zone phases (JSON ProfileBar[]) for recordings
  lapsJson          String? // provider lap markers (JSON), populated later (#328); null when absent
  rawJson           String // full provider payload, verbatim (lossless; see strava/types.ts)
  promotedSessionId String?
  tssValue          Float? // computed TSS (null = unavailable)
  tssFormula        String? // 'coggan' | 'hrTSS' | 'rTSS' | 'sTSS' | 'sRPE'
  tssConfidence     String? // 'high' | 'medium' | 'low'
  createdAt         DateTime @default(now())

  athlete         User              @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  promotedSession WorkoutSession?   @relation("ImportPromotedTo", fields: [promotedSessionId], references: [id])
  recordingFor    WorkoutSession[]  @relation("SessionRecording")
  stream          ActivityStream?
  detection       WorkoutDetection?

  @@unique([externalProvider, externalId])
  @@index([athleteId])
}

/// Per-sample telemetry for an Activity Import (ADR 0020): the moment-to-moment
/// power / heart-rate / pace the Workout Detail View overlays against the plan.
/// One per Activity Import (many imports have none — manual uploads, providers or
/// activities without streams), cascade-deleted with its import so a stream rides
/// with its Recording and honours ADR 0012 (disconnect preserves Recordings).
///
/// Channels are downsampled at ingest to a coarse `resolutionSec` floor and/or a
/// capped `sampleCount` (the overlay needs no 1 Hz fidelity; this bounds storage)
/// and persisted as JSON: `timeSec` is the evenly-spaced elapsed-seconds axis;
/// each optional channel is a same-length `Array<number | null>` where `null`
/// marks a gap (a pause) so the chart breaks the line rather than interpolating.
model ActivityStream {
  id            String   @id @default(cuid())
  resolutionSec Int // seconds between samples on the even grid
  sampleCount   Int // number of samples (== timeSec.length)
  timeSec       String // JSON number[] — elapsed seconds, evenly spaced
  power         String? // JSON Array<number | null> — watts, null across gaps
  heartrate     String? // JSON Array<number | null> — bpm
  pace          String? // JSON Array<number | null> — sec/km
  createdAt     DateTime @default(now())

  activityImport   ActivityImport @relation(fields: [activityImportId], references: [id], onDelete: Cascade)
  activityImportId String         @unique
}

/// A Structure Detection (ADR 0032/0033): the single workout structure detected
/// from a run/bike Activity Import's telemetry. A 1:1 sibling of ActivityStream,
/// keyed to the import and cascade-deleted with it — it rides with a promoted
/// Recording on disconnect exactly like the stream (ADR 0012). Only the winning
/// structure is persisted (no ranked candidates); the internal 0–1 score is not
/// stored (ADR 0032/0033) — only the graded confidence label. Inert groundwork:
/// no engine, job, or write path populates this yet.
model WorkoutDetection {
  id String @id @default(cuid())

  // The detected structure as JSON conforming to WorkoutStructureSchema
  // (discipline + Block → WorkoutStep → IntensityTarget, no authoring envelope).
  // Materializes into a real Workout with no translation.
  structureJson String

  // Detection Confidence grade (ADR 0033) — the same honesty vocabulary the rest
  // of the app speaks. Absent (no row) means the honesty gate failed.
  confidence String // "high" | "medium" | "low"

  // Provenance so a future re-detection trigger can tell stale from current.
  engineVersion String
  computedAt    DateTime

  createdAt DateTime @default(now())

  activityImport   ActivityImport @relation(fields: [activityImportId], references: [id], onDelete: Cascade)
  activityImportId String         @unique
}

/// A unit of background work for the in-process job worker (ADR 0013). The queue
/// is deliberately domain-agnostic: `kind` selects a handler and `payload` is an
/// opaque JSON blob the handler interprets. Backfill (#74) is the first kind;
/// webhook-fetch (#76) and reconciliation-poll (#77) reuse the same table.
///
/// `status` lifecycle: pending → running → completed | failed. A failed run with
/// attempts remaining returns to `pending` with `runAt` pushed into the future
/// (exponential backoff); exhausting `maxAttempts` is terminal (`failed`).
model Job {
  id          String    @id @default(cuid())
  kind        String // e.g. 'strava-backfill'
  payload     String    @default("{}") // JSON-encoded handler arguments
  status      String    @default("pending") // 'pending' | 'running' | 'completed' | 'failed'
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now()) // earliest time the job may be claimed (backoff cursor)
  lastError   String?
  startedAt   DateTime? // when the current/last run was claimed
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

model LoadSnapshot {
  id              String   @id @default(cuid())
  athleteId       String
  date            String // YYYY-MM-DD in athlete timezone
  // The Training Load input: the endurance disciplines only (ADR 0046 §2).
  // NOT the sum of `tssByDiscipline` — see the comment at snapshot.server.ts.
  tssTotal        Float    @default(0)
  // JSON: { bike?, run?, swim?, strength? } — the display split, every
  // discipline's figure, including the strength `sRPE` the total refuses.
  tssByDiscipline String   @default("{}")
  ctl             Float    @default(0) // chronic training load (42-day EWMA)
  atl             Float    @default(0) // acute training load (7-day EWMA)
  tsb             Float    @default(0) // training stress balance = CTL - ATL (prior day)
  computedAt      DateTime @default(now())

  athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, date])
  @@index([athleteId])
  @@index([athleteId, date])
}

/// A one-time, athlete-visible explanation for a Training Load recompute that
/// moved a number the athlete had already been reading. ADR 0008's posture —
/// the system "never auto-switches silently" — applied to a correction there is
/// nothing to opt into: unlike an athlete fitting a power meter, nothing about
/// their data changed, so the old figure was simply wrong and the new one is not
/// a preference. What is owed is therefore an explanation, not an offer.
///
/// Written once by the one-shot backfill that caused the movement, dismissed by
/// the athlete. Unique on (athlete, kind), so a re-run can never nag twice. See
/// ADR 0046 §2.
model LoadRecomputeNotice {
  id   String @id @default(cuid())
  kind String // 'strength-left-the-triad'

  /// The athlete's latest CTL immediately before and after the recompute, so
  /// the line can name the movement it caused rather than warn in the abstract.
  ctlBefore Float
  ctlAfter  Float

  createdAt   DateTime  @default(now())
  dismissedAt DateTime?

  athlete   User   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId String

  // No separate [athleteId] index: the unique index above already has athleteId
  // as its leftmost column, so it serves athlete-scoped lookups (#389).
  @@unique([athleteId, kind])
}

/// The Week Replan decision record (ADR 0025): what the app decided — at most
/// once — when a Training Week closed, whether or not anything changed. Keyed
/// unique on (athlete, closed week's Monday); that uniqueness IS the
/// idempotency guard, so the multiplicative volume scale can never compound
/// and declined outcomes ("no adjustment — not enough data") are as durable as
/// the adjustment itself. Written only on the load-recompute path (ADR 0008),
/// never re-opened by late data.
model WeekReplan {
  id      String @id @default(cuid())
  weekKey String // closed week's Monday, YYYY-MM-DD in the Athlete Timezone
  outcome String // 'adjusted' | 'no-change' | 'insufficient-data'
  reason  String // plain-language reason composed by decideWeekReplan

  // Provenance: the inputs the decision was made on, as available at the time.
  adherenceRatio Float? // the closed week's Weekly Plan Adherence ratio (null = unmeasurable)
  tsb            Float? // the TSB the decision read (null = no load history)
  appliedScale   Float? // the volume scale applied to the target week (null unless adjusted)

  createdAt DateTime @default(now())

  athlete   User   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId String

  @@unique([athleteId, weekKey])
  @@index([athleteId])
}

/// An athlete's authorized link to an external training service account
/// (Strava, Garmin, Polar). One per athlete per external service. See CONTEXT.md
/// "Account Connection" and ADR 0014. The `provider` column is a plain string,
/// not an enum the schema discriminates on.
model AccountConnection {
  id                  String    @id @default(cuid())
  provider            String // 'strava' | 'intervalsicu' | 'garmin' | 'polar'
  externalAthleteId   String // the external service's athlete id
  accessToken         String // OAuth access token, or the API key for key-based providers (ADR 0026)
  refreshToken        String? // null for key-based providers — API keys don't rotate (ADR 0026)
  expiresAt           DateTime? // when the access token expires; null for key-based providers
  status              String    @default("active") // 'active' | 'expired' | 'revoked' | 'error'
  connectedAt         DateTime  @default(now())
  lastSyncedAt        DateTime? // high-water mark for manual sync / reconciliation
  backfillCompletedAt DateTime? // set once the Backfill Window job completes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete   User   @relation(fields: [athleteId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  athleteId String

  @@unique([athleteId, provider])
  @@index([athleteId])
}
